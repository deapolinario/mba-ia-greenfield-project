{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/../src/test/jest-global-setup.ts",
  "setupFiles": ["<rootDir>/../src/test/jest-setup-env.ts"]
}
