# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Queue (Redis / BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Object storage (MinIO for local development)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true
UPLOAD_PART_SIZE_BYTES=8388608
PRESIGN_UPLOAD_TTL_SECONDS=3600
PRESIGN_DOWNLOAD_TTL_SECONDS=300
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_ACCEPTED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska
